<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  parallel="tests"  → each <test> block runs in its own thread
  thread-count="3"  → one thread per <test> block (UI + Users + Posts)
  The API test methods within each block run sequentially by default;
  set parallel="methods" on individual <test> blocks to go deeper.
-->
<suite name="All Tests" verbose="1" parallel="tests" thread-count="3">

    <!-- =========================================================
         UI Tests – must run single-threaded (one browser driver)
         ========================================================= -->
    <test name="UI Tests - Login" parallel="none">
        <packages>
            <package name="com.ecommerce.tests"/>
        </packages>
    </test>

    <!-- =========================================================
         API Tests – stateless HTTP calls; safe to parallelise
         parallel="methods" runs every @Test method concurrently
         ========================================================= -->
    <test name="API Tests - Users" parallel="methods" thread-count="4">
        <classes>
            <class name="com.ecommerce.tests.api.UserApiTest"/>
        </classes>
    </test>

    <test name="API Tests - Posts" parallel="methods" thread-count="4">
        <classes>
            <class name="com.ecommerce.tests.api.PostApiTest"/>
        </classes>
    </test>

</suite>
